{
  "name": "@megazen/shared",
  "version": "1.0.0",
  "description": "Shared types and utilities for MEGAZEN",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./constants": {
      "types": "./dist/constants/api.d.ts",
      "default": "./dist/constants/api.js"
    },
    "./utils": {
      "types": "./dist/utils/api-client.d.ts",
      "default": "./dist/utils/api-client.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.6.5"
  }
}
